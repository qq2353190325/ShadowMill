# ---------- 依赖 ----------
# node 依赖
node_modules/

# 打包内置运行时（ffmpeg / node / hyperframes + chrome-headless-shell，体积大不进 git）
resources/

# 运行环境包产物（scripts/pack-runtime.mjs 生成：runtime.7z + runtime.json + 7za.exe，体积大不进 git）
build/

# ---------- 构建产物 ----------
# electron-builder 输出（安装包 / 便携版 / 缓存）
dist/

# electron-vite 构建输出
out/

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-error.log*

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
Thumbs.db
Desktop.ini

# ---------- 临时 / 缓存 ----------
.tmp/
*.tmp

# ---------- 自动更新（本地调试用，feed 地址因机而异）----------
dev-app-update.yml

# ---------- 权限修复恢复记录（本机生成，含本机 SID/路径）----------
.acl-recovery/
