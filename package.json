{
  "name": "shadowmill",
  "version": "0.0.8",
  "description": "ShadowMill（影坊）：Electron 桌面应用，以「项目」为粒度的一站式音视频创作流水线",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "runtime:pack": "node scripts/pack-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.agent.json",
    "pack": "npm run runtime:pack && npm run build && npx electron-builder --dir",
    "dist": "npm run runtime:pack && npm run build && npx electron-builder --win",
    "stage": "node scripts/release.mjs --stage",
    "ship": "npm run dist && npm run stage",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.shadowmill.app",
    "productName": "ShadowMill",
    "electronVersion": "44.7.0",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "vendor/**/*",
      "README.md",
      "CHANGELOG.md",
      "!node_modules/@vue/**/*",
      "!node_modules/@babel/**/*",
      "!node_modules/vue/**/*",
      "!*.js.map"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "packElevateHelper": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://chaoming-zhaoling.oss-cn-beijing.aliyuncs.com/shadowmill/"
      }
    ],
    "extraResources": [
      {
        "from": "resources/whisper",
        "to": "whisper"
      },
      {
        "from": "build/tools",
        "to": "tools"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "openai": "^7.15.0",
    "opencc-js": "^1.4.2",
    "vue": "^3.5.43"
  }
}
